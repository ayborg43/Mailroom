# Copy to .env for local `docker compose up`, or set these as environment
# variables in your deployment platform's UI (Dokploy, etc.) instead — both
# work identically since docker-compose.yml reads them the same way.
#
# These override the matching settings in config.yaml; anything not listed
# here (storage paths, queue backoff, rate-limit thresholds, ...) is
# YAML-only — see configs/config.example.yaml and README.md.

MAILSERVER_HOSTNAME=mail.example.com
MAILSERVER_DOMAINS=example.com
MAILSERVER_ADMIN_EMAIL=admin@example.com
MAILSERVER_ADMIN_PASSWORD=changeme

# Leave empty unless a reverse proxy/load balancer needs to be trusted to
# supply the real client IP (Traefik always does, for the webmail login) —
# see README's "Deploying with Dokploy" section before setting this.
MAILSERVER_TRUSTED_PROXIES=

# The Docker network Traefik itself is attached to. Plain hand-rolled
# Traefik setups usually use "traefik" (the default); Dokploy's own Traefik
# uses "dokploy-network".
TRAEFIK_NETWORK=traefik

# Uncomment to use Postgres instead of the default embedded SQLite —
# e.g. a database your platform (Dokploy's "Databases" feature, etc.)
# provisioned for you.
# MAILSERVER_DATABASE_DRIVER=postgres
# MAILSERVER_DATABASE_DSN=postgres://user:pass@host:5432/mailserver?sslmode=disable
